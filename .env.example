# Optional overrides for `docker compose up` (copy to .env). All values have safe local defaults.
WEB_PORT=3000
API_PORT=3001
DB_PORT=5433
PUBLIC_WEB_URL=http://localhost:3000
JWT_SECRET=local-docker-secret-change-me-0123456789abcdef
TEST_API_KEY=local-test-api-key
# if-empty | always | reset | never
SEED_ON_START=if-empty
# Set to "mailpit" and run `docker compose --profile mail up` to see e-mails in http://localhost:8025
SMTP_HOST=
LOG_LEVEL=info
