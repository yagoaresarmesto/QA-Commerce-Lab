# Copy to deploy/vps/.env on the server (chmod 600). NEVER commit the real file.

# Image published by the "Release" GitHub Actions workflow (replace OWNER, lower-case)
IMAGE=ghcr.io/OWNER/qa-commerce-lab:latest

# DNS A/AAAA records pointing to the VPS. Examples:
#   with your own domain:  demo.example.com / testing.example.com
#   without a domain:      demo.203-0-113-10.sslip.io / testing.203-0-113-10.sslip.io
DEMO_DOMAIN=demo.example.com
TESTING_DOMAIN=testing.example.com
ACME_EMAIL=you@example.com

# Generate each one with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
DEMO_DB_PASSWORD=change-me
TESTING_DB_PASSWORD=change-me
