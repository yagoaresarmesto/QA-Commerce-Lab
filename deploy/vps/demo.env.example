# Public demo environment (copy to deploy/vps/demo.env)
APP_ENV=demo
PUBLIC_WEB_URL=https://demo.example.com
CORS_ORIGINS=https://demo.example.com
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# The testing API is ALWAYS disabled when APP_ENV=demo (code-level guarantee)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
SWAGGER_ENABLED=true
SEED_ON_START=if-empty
# Nightly reset to the reference dataset (Europe/Madrid). Empty = disabled.
AUTO_RESET_CRON=0 4 * * *
LOG_LEVEL=info
