# Remote testing environment (copy to deploy/vps/testing.env)
APP_ENV=testing
PUBLIC_WEB_URL=https://testing.example.com
CORS_ORIGINS=https://testing.example.com
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
TEST_API_ENABLED=true
# openssl rand -hex 32  (store it as a GitHub secret in your automation repository)
TEST_API_KEY=change-me-to-a-random-key-of-at-least-24-chars
# Global reset wipes EVERYTHING: keep it false if several suites/people share this environment
ALLOW_GLOBAL_RESET=false
ALLOW_GLOBAL_FAULTS=false
RATE_LIMIT_ENABLED=false
SWAGGER_ENABLED=true
SEED_ON_START=if-empty
PAYMENT_PENDING_DELAY_MS=15000
PAYMENT_TIMEOUT_DELAY_MS=8000
LOG_LEVEL=info
