# ─── QA Commerce Lab API · local development (npm run dev) ───
# Copy to apps/api/.env  (cp apps/api/.env.example apps/api/.env)

# local | testing | demo | production
APP_ENV=local
PORT=3001
DATABASE_URL=postgresql://qacl:qacl@localhost:5432/qacl?schema=public

# Public URL of the storefront (used in e-mail links such as password reset)
PUBLIC_WEB_URL=http://localhost:3000
# Comma separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth (JWT secret must be >= 32 chars outside local)
JWT_SECRET=local-dev-secret-change-me-please-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30

# Testing infrastructure (never enabled when APP_ENV=demo|production)
TEST_API_ENABLED=true
TEST_API_KEY=local-test-api-key
ALLOW_GLOBAL_RESET=true

# Controls
RATE_LIMIT_ENABLED=false
SWAGGER_ENABLED=true

# Payment simulator & background jobs
PAYMENT_PENDING_DELAY_MS=15000
PAYMENT_TIMEOUT_DELAY_MS=8000
ORDER_RESERVATION_MINUTES=30
BANK_TRANSFER_RESERVATION_HOURS=72
JOBS_ENABLED=true
JOBS_INTERVAL_MS=5000

# Mail: always stored in the local outbox; optionally also sent through SMTP (e.g. Mailpit)
SMTP_HOST=
SMTP_PORT=1025
MAIL_FROM="QA Commerce Lab <no-reply@qacommerce.test>"

LOG_LEVEL=info
LOG_PRETTY=true
